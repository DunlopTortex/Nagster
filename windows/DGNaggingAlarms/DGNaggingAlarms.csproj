<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Alarm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Alarm.ico" />
    <EmbeddedResource Include="Web\index.html" LogicalName="DGNaggingAlarms.Web.index.html" />
    <!-- Generated by tools\CreateWebIcons.ps1 -->
    <EmbeddedResource Include="Web\apple-touch-icon.png" LogicalName="DGNaggingAlarms.Web.apple-touch-icon.png" />
    <EmbeddedResource Include="Web\favicon.png" LogicalName="DGNaggingAlarms.Web.favicon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel hosts the optional web interface; it ships with .NET, so there's no extra package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
