<UserControl x:Class="DGNaggingAlarms.Controls.SoundPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Unloaded="Picker_Unloaded">
    <DockPanel>
        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Margin="8,0,0,0" Width="36" Padding="0"
                FontFamily="{StaticResource Font.Icons}" Content="&#xE768;" ToolTip="Preview this sound"
                Click="Preview_Click" />
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Browse…" Click="Browse_Click"
                ToolTip="Use a WAV or MP3 file of your own" />
        <ComboBox x:Name="Choices" MaxDropDownHeight="360" />
    </DockPanel>
</UserControl>
