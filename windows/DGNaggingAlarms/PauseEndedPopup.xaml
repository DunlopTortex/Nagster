<Window x:Class="DGNaggingAlarms.PauseEndedPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pause ended" Width="390" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True">
    <Grid>
        <Border Style="{StaticResource DialogShadow}" />
        <Border Margin="14" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="16,14">
            <DockPanel>
                <Border DockPanel.Dock="Top" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.WarningSubtle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource Text.Glyph}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,0,6,0" />
                        <TextBlock Text="PAUSE ENDED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                    </StackPanel>
                </Border>

                <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="-2,0">
                    <Button Style="{StaticResource Button.Accent}" Margin="2,0" Click="Unpause_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Unpause" />
                        </StackPanel>
                    </Button>
                    <Button Margin="2,0" Click="Snooze_Click" ToolTip="Keep alarms paused for another 30 minutes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" Style="{StaticResource Text.Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Snooze 30 min" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel Margin="0,10,0,12">
                    <TextBlock Text="Alarms are still paused" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
