<Window x:Class="Nagster.AlarmCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active alarms" Icon="Assets/Alarm.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Width="780" Height="660" MinWidth="580" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Font.Text}"
        Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="14" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border Style="{StaticResource DialogShadow}" />
        <Border Style="{StaticResource DialogFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Background="Transparent" Margin="22,14,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Title}" Text="Active alarms" />
                        <TextBlock Text="Alarms going off now, including those waiting for space on screen, and alarms snoozed until later." Style="{StaticResource Text.Hint}" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Close}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsCancel="True" ToolTip="Close" Click="Close_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="22,12,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="RingingHeading" Style="{StaticResource Text.Section}" Text="Going off now" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,14,8,8">
                        <Grid>
                            <DataGrid x:Name="ActiveGrid" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Grid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="*" />
                                    <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText}" Width="*" />
                                    <DataGridTemplateColumn Header="Status" Width="104" SortMemberPath="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusPill}">
                                                    <TextBlock Text="{Binding Status}" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Glyph}" FontSize="26"
                                           Foreground="{DynamicResource Brush.Success}" />
                                <TextBlock Text="Nothing going off" Margin="0,8,0,0" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SnoozedHeading" Grid.Row="2" Style="{StaticResource Text.Section}" Text="Snoozed" Margin="0,16,0,8" />
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,14,8,8">
                        <Grid>
                            <DataGrid x:Name="SnoozedGrid" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Grid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Goes off again" Binding="{Binding AlertText}" Width="*" SortMemberPath="Occurrence.AlertAt" />
                                    <DataGridTextColumn Header="Snoozed by" Binding="{Binding SnoozedBy}" Width="110" />
                                    <DataGridTextColumn Header="Times" Binding="{Binding SnoozeCount}" Width="64" />
                                    <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="SnoozedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#xE916;" Style="{StaticResource Text.Glyph}" FontSize="26"
                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                <TextBlock Text="Nothing snoozed" Margin="0,8,0,0" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Dismiss" Click="Dismiss_Click" />
                        <Button Content="Reschedule…" Margin="8,0,0,0" Click="Reschedule_Click" />
                        <Button Content="Snooze 1 hour" Margin="8,0,0,0" Click="Snooze_Click" />
                        <Button Style="{StaticResource Button.Accent}" Margin="8,0,0,0" Click="Complete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Glyph}" Margin="0,0,8,0" />
                                <TextBlock Text="Complete" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
