<Window x:Class="Nagster.QuickReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nagster.Controls"
        Title="Quick reminder" Icon="Assets/Alarm.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="480" WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Font.Text}"
        Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True">
    <Grid>
        <Border Style="{StaticResource DialogShadow}" />
        <Border Style="{StaticResource DialogFrame}">
            <StackPanel>
                <Grid Background="Transparent" Margin="22,14,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Text.Glyph}" FontSize="16" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Style="{StaticResource Text.Title}" Text="Quick reminder" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Close}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            IsCancel="True" ToolTip="Cancel" />
                </Grid>

                <StackPanel Margin="22,16,22,20">
                    <TextBlock Text="What do you need to remember?" Style="{StaticResource Text.Field}" />
                    <TextBox x:Name="TitleBox" MaxLength="160" Tag="e.g. Call the dentist" />
                    <TextBlock Text="When?" Style="{StaticResource Text.Field}" Margin="0,14,0,6" />
                    <ComboBox x:Name="WhenBox" SelectedIndex="1" SelectionChanged="WhenBox_SelectionChanged">
                        <ComboBoxItem Content="In 5 minutes" /><ComboBoxItem Content="In 15 minutes" />
                        <ComboBoxItem Content="In 30 minutes" /><ComboBoxItem Content="In 1 hour" />
                        <ComboBoxItem Content="Tomorrow at 9:00 AM" /><ComboBoxItem Content="At a time I choose…" />
                    </ComboBox>
                    <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <DatePicker x:Name="CustomDate" Width="170" />
                        <controls:TimePicker x:Name="CustomTime" Width="130" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource DialogFooter}">
                    <DockPanel>
                        <Button Content="More options…" Style="{StaticResource Button.Link}" Click="More_Click"
                                ToolTip="Open the full alarm editor" />
                        <Button Content="Create" Style="{StaticResource Button.Accent}" MinWidth="110" HorizontalAlignment="Right"
                                IsDefault="True" Click="Create_Click" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
