<UserControl x:Class="Nagster.Controls.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Border x:Name="Field" Style="{StaticResource Field.Frame}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" Style="{StaticResource TextBox.Bare}" Padding="8,6,4,6" Tag="h:mm AM"
                         LostKeyboardFocus="Input_LostKeyboardFocus" PreviewKeyDown="Input_PreviewKeyDown" />
                <Button x:Name="OpenButton" Grid.Column="1" Style="{StaticResource Button.Icon}" Width="30" Height="28"
                        Margin="0,0,2,0" FontSize="13" Content="&#xE823;" Focusable="False" ToolTip="Pick a time"
                        Click="Open_Click" />
            </Grid>
        </Border>
        <Border IsHitTestVisible="False" CornerRadius="0,0,6,6" Height="2" VerticalAlignment="Bottom" Margin="1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Input}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=Picker}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Field}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="Picker_Opened" Closed="Picker_Closed" PreviewKeyDown="Picker_PreviewKeyDown">
            <Border Margin="0,0,8,8" CornerRadius="10" Background="{DynamicResource Brush.Menu}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    TextElement.FontFamily="{StaticResource Font.Text}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hour" Style="{StaticResource Text.Hint}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="1" Text="Minute" Style="{StaticResource Text.Hint}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <ListBox x:Name="HourList" Grid.Row="1" Style="{StaticResource TimeColumn}"
                                 ItemContainerStyle="{StaticResource TimeCell}" SelectionChanged="Part_SelectionChanged" />
                        <ListBox x:Name="MinuteList" Grid.Row="1" Grid.Column="1" Style="{StaticResource TimeColumn}"
                                 ItemContainerStyle="{StaticResource TimeCell}" SelectionChanged="Part_SelectionChanged" />
                        <ListBox x:Name="PeriodList" Grid.Row="1" Grid.Column="2" Style="{StaticResource TimeColumn}"
                                 Height="Auto" VerticalAlignment="Top"
                                 ItemContainerStyle="{StaticResource TimeCell}" SelectionChanged="Part_SelectionChanged" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="8">
                        <DockPanel>
                            <Button Content="Now" Click="Now_Click" MinHeight="28" Padding="12,4" />
                            <Button Content="Done" Style="{StaticResource Button.Accent}" MinHeight="28" Padding="16,4"
                                    HorizontalAlignment="Right" Click="Done_Click" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
