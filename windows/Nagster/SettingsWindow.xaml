<Window x:Class="Nagster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nagster.Controls"
        Title="Settings" Icon="Assets/Alarm.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Width="600" Height="720" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Font.Text}"
        Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="14" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A label/hint pair on the left with its control on the right -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource DialogShadow}" />
        <Border Style="{StaticResource DialogFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Background="Transparent" Margin="22,14,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Style="{StaticResource Text.Title}" Text="Settings" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Close}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            IsCancel="True" ToolTip="Close without saving" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="22,0,22,18">

                        <TextBlock Style="{StaticResource Text.Section}" Text="Responding to alarms" Margin="0,4,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Response time before automatic snooze" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="Seconds. Use 0 to wait for you indefinitely." Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                    <TextBox x:Name="ResponseSeconds" Grid.Column="1" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Automatic snooze length" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="e.g. 30m, 1h or 1d, using the units below." Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                    <TextBox x:Name="AutoSnooze" Grid.Column="1" />
                                </Grid>
                                <TextBlock Text="Snooze choices" Style="{StaticResource Text.Label}" />
                                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,6"
                                           Text="Separate with commas. Add a unit after each number: s seconds, m minutes, h hours, d days, w weeks, mo months, y years. A number on its own means minutes. These appear in each alarm's Snooze menu." />
                                <TextBox x:Name="SnoozeChoices" Tag="e.g. 10m, 1h, 1d, 1w, 1mo" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Sound" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Default alarm sound" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Each sound plays three times, waits a minute, and repeats while the alarm is active."
                                           Style="{StaticResource Text.Hint}" Margin="0,0,0,6" />
                                <controls:SoundPicker x:Name="DefaultSound" DefaultLabel="Windows alert" />
                                <TextBlock Text="Play alarms on" Style="{StaticResource Text.Label}" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,6"
                                           Text="If this device isn't connected when an alarm goes off, the system default is used instead. Previews play here too." />
                                <ComboBox x:Name="AudioDevice" />
                                <CheckBox x:Name="SetAlarmVolume" Style="{StaticResource Toggle}" Margin="0,16,0,0"
                                          Checked="SetAlarmVolume_Changed" Unchecked="SetAlarmVolume_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Set volume for alarms" />
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Text="Sets the device to this volume (and unmutes it) while an alarm sounds, then puts it back. If you change the volume yourself meanwhile, your change is kept." />
                                    </StackPanel>
                                </CheckBox>
                                <Grid x:Name="AlarmVolumeRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE767;" Style="{StaticResource Text.Glyph}" Foreground="{DynamicResource Brush.SubtleText}" Margin="0,0,12,0" />
                                    <Slider x:Name="AlarmVolume" Grid.Column="1" Minimum="5" Maximum="100" SmallChange="5" LargeChange="10"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Hint}" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Value, ElementName=AlarmVolume, StringFormat={}{0:0}%}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Quiet hours" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="QuietEnabled" Style="{StaticResource Toggle}"
                                          Checked="QuietEnabled_Changed" Unchecked="QuietEnabled_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Silence alarms during quiet hours" />
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Text="Alarms still pop up on time, just without sound. If one is still waiting when quiet hours end, it starts sounding then." />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="QuietTimesRow" Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="From" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
                                    <controls:TimePicker x:Name="QuietStart" Width="130" />
                                    <TextBlock Text="to" Style="{StaticResource Text.Label}" Margin="12,0,10,0" />
                                    <controls:TimePicker x:Name="QuietEnd" Width="130" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Alarm hours" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AlarmHoursEnabled" Style="{StaticResource Toggle}"
                                          Checked="AlarmHoursEnabled_Changed" Unchecked="AlarmHoursEnabled_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Only ring PC-only alarms during these hours" />
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Text="One that comes due outside them is snoozed until they next start, unless its deadline comes first. Alarms for all devices ring as usual; the iPhone has its own hours." />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="AlarmHoursRow" Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="From" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
                                    <controls:TimePicker x:Name="AlarmHoursStart" Width="130" />
                                    <TextBlock Text="to" Style="{StaticResource Text.Label}" Margin="12,0,10,0" />
                                    <controls:TimePicker x:Name="AlarmHoursEnd" Width="130" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Phone notifications" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="PushoverEnabled" Style="{StaticResource Toggle}"
                                          Checked="PushoverEnabled_Changed" Unchecked="PushoverEnabled_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Notify me through Pushover when an alarm goes unanswered" />
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Text="Sent the first time each alarm snoozes automatically in a day." />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="PushoverFields" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Your user key" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="PushoverUserKey" ToolTip="Shown on your pushover.net dashboard" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Application API token" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="PushoverToken" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,6,0,0">
                                        <Run Text="Create an application token at" />
                                        <Hyperlink NavigateUri="https://pushover.net/apps/build" RequestNavigate="Link_RequestNavigate"
                                                   Foreground="{DynamicResource Brush.Accent}">pushover.net/apps/build</Hyperlink><Run Text=". Both keys are stored encrypted for your Windows account." />
                                    </TextBlock>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Device (optional)" Style="{StaticResource Text.Field}" />
                                            <TextBox x:Name="PushoverDevice" Tag="All my devices" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Priority" Style="{StaticResource Text.Field}" />
                                            <ComboBox x:Name="PushoverPriority" SelectedIndex="0">
                                                <ComboBoxItem Content="Normal" ToolTip="Follows your phone's Pushover quiet hours" />
                                                <ComboBoxItem Content="High" ToolTip="Always sounds, even during your phone's quiet hours" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button x:Name="PushoverTestButton" Content="Send test" DockPanel.Dock="Left" Click="PushoverTest_Click" />
                                        <TextBlock x:Name="PushoverStatus" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Calendars" />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Manage calendars…" Click="Calendars_Click" VerticalAlignment="Center" />
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Create alarms from Google, Microsoft 365 and Outlook events" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="CalendarSummary" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Web access" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="WebEnabled" Style="{StaticResource Toggle}" Checked="WebEnabled_Changed" Unchecked="WebEnabled_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Allow access from a web browser" />
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Text="See and answer alarms and create new ones from your phone or another computer, and sync the Nagster iPhone app. Anyone on your network can reach the sign-in page, so use a good password. The connection isn't encrypted: don't expose this port to the internet." />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="WebFields" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Port" Style="{StaticResource Text.Field}" />
                                            <TextBox x:Name="WebPort" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="WebPasswordLabel" Text="Password" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="WebPassword" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="WebAddressText" Style="{StaticResource Text.Hint}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="WebStatusText" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />
                                    <DockPanel Margin="0,12,0,0">
                                        <Button x:Name="SignOutDevicesButton" DockPanel.Dock="Right" Content="Sign out all devices" Margin="12,0,0,0"
                                                VerticalAlignment="Top" Click="SignOutDevices_Click"
                                                ToolTip="Every phone and browser will need the password again" />
                                        <StackPanel>
                                            <TextBlock Text="Signed-in devices" Style="{StaticResource Text.Label}" />
                                            <TextBlock x:Name="WebDevicesText" Style="{StaticResource Text.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Cloud sync" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Optional. Keeps this PC and your iPhones in step from anywhere, without being on the same network. Everything is encrypted on this PC with your sync passphrase before it's sent; the cloud only ever sees ciphertext, so nobody else can read your alarms, Nagster included. Forget the passphrase and the cloud copy can't be read by anyone; your alarms stay on your devices. While this PC is running, it's the one that applies changes from your iPhones." />
                                <StackPanel x:Name="CloudOffPanel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Email" Style="{StaticResource Text.Field}" />
                                            <TextBox x:Name="CloudEmail" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Account password" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="CloudPassword" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Sync passphrase" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="CloudPassphrase" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Passphrase again (first device only)" Style="{StaticResource Text.Field}" />
                                            <PasswordBox x:Name="CloudPassphraseAgain" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="CloudPassphraseHint" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <CheckBox x:Name="CloudOwnProject" Style="{StaticResource Toggle}" Margin="0,12,0,0"
                                              Checked="CloudOwnProject_Changed" Unchecked="CloudOwnProject_Changed">
                                        <TextBlock Text="Use my own Supabase project" />
                                    </CheckBox>
                                    <Grid x:Name="CloudOwnFields" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Project URL" Style="{StaticResource Text.Field}" />
                                            <TextBox x:Name="CloudUrl" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Publishable key" Style="{StaticResource Text.Field}" />
                                            <TextBox x:Name="CloudKey" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="Create account" Click="CloudCreate_Click" />
                                        <Button Content="Turn on" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" Click="CloudOn_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="CloudOnPanel">
                                    <TextBlock x:Name="CloudAccountText" Style="{StaticResource Text.Label}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="Delete account…" Style="{StaticResource Button.Danger}" Click="CloudDelete_Click" />
                                        <Button Content="Turn off" Margin="8,0,0,0" Click="CloudOff_Click" />
                                        <Button Content="Sync now" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" Click="CloudSync_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="CloudStatusText" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Alarm windows" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Screen corner" Style="{StaticResource Text.Label}" />
                                    <ComboBox x:Name="PopupCorner" Grid.Column="1">
                                        <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                                        <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                        <ComboBoxItem Content="Top right" Tag="TopRight" />
                                        <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                    </ComboBox>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background opacity" Style="{StaticResource Text.Label}" />
                                    <Slider x:Name="PopupOpacity" Grid.Column="1" Minimum="0.5" Maximum="1" SmallChange="0.05"
                                            LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Hint}" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Value, ElementName=PopupOpacity, StringFormat={}{0:P0}}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Maximum visible at once" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="1 to 5. Extra alarms wait in Active alarms. Alarm windows always stay on top."
                                                   Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                    <TextBox x:Name="MaxPopups" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="Startup" />
                        <Border Style="{StaticResource Card}">
                            <CheckBox x:Name="StartWithWindows" Style="{StaticResource Toggle}">
                                <StackPanel>
                                    <TextBlock Text="Start when I sign in to Windows" />
                                    <TextBlock Text="Runs quietly in the system tray." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                    <DockPanel>
                        <Button Click="Preview_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE890;" Style="{StaticResource Text.Glyph}" Margin="0,0,8,0" />
                                <TextBlock Text="Preview popup" />
                            </StackPanel>
                        </Button>
                        <Button Content="Save settings" Style="{StaticResource Button.Accent}" MinWidth="120" HorizontalAlignment="Right"
                                IsDefault="True" Click="Save_Click" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
