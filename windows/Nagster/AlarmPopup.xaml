<Window x:Class="Nagster.AlarmPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm" Width="390" Height="290"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PopupButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Fill and shadow; its background opacity comes from Settings. -->
        <Border x:Name="Fill" Style="{StaticResource DialogShadow}" />
        <Border Margin="14" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="16,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Background="{DynamicResource Brush.AccentSubtle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TypeGlyph" Text="&#xEA8F;" Style="{StaticResource Text.Glyph}" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TypeText" Text="ALARM" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuietBadge" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" Visibility="Collapsed"
                            Background="{DynamicResource Brush.Control}" ToolTip="No sound during quiet hours (see Settings)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74F;" Style="{StaticResource Text.Glyph}" FontSize="11"
                                       Foreground="{DynamicResource Brush.SubtleText}" Margin="0,0,6,0" />
                            <TextBlock Text="Quiet hours" FontSize="11" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.Warning}" FontSize="12" Margin="2,0,0,8"
                               TextWrapping="Wrap" MaxHeight="34" />
                    <UniformGrid Rows="1" Margin="-2,0">
                        <Button Style="{StaticResource PopupButton}" Background="{DynamicResource Brush.Accent}" BorderBrush="Transparent"
                                Foreground="{DynamicResource Brush.OnAccent}" FontWeight="SemiBold" Content="Complete" Click="Complete_Click" />
                        <Button x:Name="SnoozeButton" Style="{StaticResource PopupButton}" Content="Snooze ▾" Click="Snooze_Click" />
                        <Button Style="{StaticResource PopupButton}" Content="Reschedule" Click="Reschedule_Click" />
                        <Button Style="{StaticResource PopupButton}" Content="Dismiss" Click="Dismiss_Click" />
                    </UniformGrid>
                    <Button x:Name="MoreButton" Style="{StaticResource Button.Link}" Visibility="Collapsed" Margin="-4,6,0,0"
                            HorizontalAlignment="Left" Click="More_Click" />
                </StackPanel>

                <StackPanel Margin="0,10,0,8">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" />
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource Text.Hint}" FontSize="12.5" MaxHeight="36"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Text.Glyph}" FontSize="12"
                                   Foreground="{DynamicResource Brush.SubtleText}" Margin="0,0,8,0" />
                        <TextBlock x:Name="DueText" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel x:Name="DeadlineRow" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Text.Glyph}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,0" />
                        <TextBlock x:Name="DeadlineText" FontSize="12.5" Foreground="{DynamicResource Brush.Warning}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
