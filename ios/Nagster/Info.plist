<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Keys Xcode can't generate from build settings; it merges these with the generated ones. -->
<dict>
	<key>NSAlarmKitUsageDescription</key>
	<string>Important alarms ring full screen, even in silent mode, until you answer them.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Nagster syncs your alarms with Nagster on your PC over your network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dgutilities.nagster.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- nagster://auth-callback: the cloud sync email confirmation link opens the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dgutilities.nagster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nagster</string>
			</array>
		</dict>
	</array>
	<!-- No encryption beyond what iOS provides (HTTPS, Keychain), so TestFlight doesn't ask for export compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
